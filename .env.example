# Copy to .env and fill in your own values. Never commit .env.

# Google AI Studio key: https://aistudio.google.com/app/apikey
# Required only for LLM-backed optimization (--engine llm / --engine auto).
# Without it the tool still runs fully offline on the heuristic engine.
GEMINI_API_KEY=your-gemini-api-key-here

# Model used for LLM-backed optimization.
PROMPT_OPTIMIZER_MODEL=gemini-2.5-flash

# Sampling temperature for the rewrite call (0.0 - 2.0).
PROMPT_OPTIMIZER_TEMPERATURE=0.4

# Engine selection: auto | heuristic | llm
#   auto      - use the LLM when a key is present, otherwise heuristic
#   heuristic - never call the network
#   llm       - require the LLM, fail loudly if unavailable
PROMPT_OPTIMIZER_ENGINE=auto
